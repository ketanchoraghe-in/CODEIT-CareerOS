# =============================================================================
#  CODEIT CareerOS — Sprint 7 AI Career Assistant
#  LOCAL DEVELOPMENT environment variable EXAMPLE
# =============================================================================
#  IMPORTANT
#   * This is an EXAMPLE file with PLACEHOLDERS ONLY. There is no real key here.
#   * Spring Boot does NOT read this file. The already-implemented configuration
#     (application.yml -> spring.ai.openai.* / app.ai.*) resolves its values from
#     REAL ENVIRONMENT VARIABLES. Use the shell commands below.
#   * NEVER write a real API key into this file, into any other file, into the
#     frontend, or into Git. The key must only ever live in your shell/session
#     environment (or your machine's user environment).
# -----------------------------------------------------------------------------
#  PowerShell — current session only (then restart the backend):
#      $env:AI_API_KEY="YOUR_API_KEY_HERE"
#      $env:AI_PROVIDER="openai"
#      $env:AI_MODEL="gpt-4o-mini"
#      $env:AI_BASE_URL="https://api.openai.com/v1"
#      .\run-backend.bat
#
#  cmd.exe — current session only (then restart the backend):
#      set AI_API_KEY=YOUR_API_KEY_HERE
#      set AI_PROVIDER=openai
#      set AI_MODEL=gpt-4o-mini
#      set AI_BASE_URL=https://api.openai.com/v1
#      run-backend.bat
#
#  PowerShell — persist for FUTURE terminals (reopen the terminal afterwards):
#      setx AI_API_KEY "YOUR_API_KEY_HERE"
#      setx AI_PROVIDER "openai"
#      setx AI_MODEL "gpt-4o-mini"
#      setx AI_BASE_URL "https://api.openai.com/v1"
# -----------------------------------------------------------------------------
#  Without AI_API_KEY the app still starts; chat history works and sending a
#  message returns HTTP 503 AI_NOT_CONFIGURED (fail fast, nothing persisted).
# =============================================================================

# --- required to enable live AI replies ---------------------------------------
AI_API_KEY=YOUR_API_KEY_HERE

# --- provider selection (defaults already match the lines below) --------------
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- optional loop/history guards (clamped by the app: 1-10 / 2-60) -----------
AI_MAX_TOOL_ITERATIONS=6
AI_HISTORY_LIMIT=20

# --- optional: completions path (ONLY needed before the next `mvn package`) ----
# application.yml now pins spring.ai.openai.chat.completions-path to
# "/chat/completions", so a base URL ending in "/v1" (the default below) builds
# "https://api.openai.com/v1/chat/completions". The packaged jar still contains
# the OLD default ("/v1/chat/completions"), which would double the segment and
# return HTTP 404. Until you rebuild, override it once per shell:
#   PowerShell: $env:SPRING_AI_OPENAI_CHAT_COMPLETIONS_PATH="/chat/completions"
#   cmd.exe:    set SPRING_AI_OPENAI_CHAT_COMPLETIONS_PATH=/chat/completions
# (equivalent alternative: set AI_BASE_URL=https://api.openai.com WITHOUT /v1)
# AI_COMPLETIONS_PATH=/chat/completions

# --- other examples (do NOT enable together with the OpenAI block above) ------
# Local Ollama (Ollama must be running and the model must be pulled):
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_API_KEY=ollama
#   AI_MODEL=<pulled-model-name>
# Any other OpenAI-compatible server:
#   AI_PROVIDER=custom
#   AI_BASE_URL=<your-endpoint>/v1
#   AI_API_KEY=<server-token>
#   AI_MODEL=<model-name>
