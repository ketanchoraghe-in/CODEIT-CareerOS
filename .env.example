# =============================================================================
#  CODEIT CareerOS — PRODUCTION environment template (Sprint 8)
# =============================================================================
#  PLACEHOLDERS ONLY — no real secret belongs in this file or in Git.
#  Copy to `backend.env` (referenced by docker-compose.prod.yml) or export
#  the same names in your host/systemd/Docker environment:
#      cp .env.example backend.env   # then fill in real values
#  For LOCAL development defaults see:
#      careeros-backend/src/main/resources/application-dev.yml
#      careeros-backend/.env.example (AI provider walkthrough)
# -----------------------------------------------------------------------------

# --- MySQL (Compose service + Spring datasource) ------------------------------
# MYSQL_* configures the mysql container; DB_* configures the Spring app.
# MYSQL_USER/MYSQL_PASSWORD and DB_USERNAME/DB_PASSWORD must match.
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=careeros
MYSQL_USER=careeros
MYSQL_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
DB_NAME=careeros
DB_URL=jdbc:mysql://mysql:3306/careeros?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectionTimeZone=UTC
DB_USERNAME=careeros
DB_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
# JPA_DDL_AUTO: keep `validate` in production (never auto-migrate prod data).
JPA_DDL_AUTO=validate

# --- Spring profile ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- JWT (fail-fast: backend refuses to start without JWT_SECRET) --------------
# Generate:  openssl rand -base64 48   (min 32 bytes / 256 bits for HS256)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Admin bootstrap (only used when the users table has no admin yet) --------
ADMIN_EMAIL=admin@your-college.edu
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# --- CORS (comma-separated, NO wildcard with credentials) ---------------------
CORS_ALLOWED_ORIGINS=https://careeros.your-college.edu

# --- Auth brute-force protection ----------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=60
REFRESH_TOKEN_CLEANUP_CRON=0 0 3 * * *

# --- AI provider (server-side only, NEVER exposed to the browser) -------------
# OpenAI:  AI_PROVIDER=openai  AI_API_KEY=sk-...  (defaults below already fit)
# Gemini:  AI_PROVIDER=gemini  GEMINI_API_KEY=AIza-...  AI_MODEL=gemini-2.0-flash
# Ollama:  AI_PROVIDER=ollama  AI_BASE_URL=http://host.docker.internal:11434/v1
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MAX_TOOL_ITERATIONS=6
AI_HISTORY_LIMIT=20
AI_REQUEST_TIMEOUT_SECONDS=120
AI_RATE_LIMIT_PER_MINUTE=20
AI_OFFLINE_FALLBACK=true

# --- CV storage: S3 in production (private objects, backend-streamed) ---------
CV_STORAGE=s3
CV_S3_BUCKET=your-careeros-cv-bucket
CV_S3_REGION=us-east-1
CV_S3_PREFIX=cvs
# Prefer an IAM role (leave both empty) over static keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# CV_S3_ENDPOINT=   # only for S3-compatible stores (MinIO etc.)

# --- Frontend API access (same-origin proxy, no browser CORS needed) ---------
# Browsers call this site's own /api/* and the Next server forwards to the
# backend. FRONTEND_API_URL is only needed to bypass the proxy (browsers call
# the API directly — then it MUST be https and in CORS origins).
# API_PROXY_URL is the server-side proxy target inside the compose network.
API_PROXY_URL=http://backend:8080
FRONTEND_API_URL=
